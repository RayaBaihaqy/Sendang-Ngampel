---
---

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-40 w-full bg-transparent text-heritage-warm-cream transition-transform duration-500 ease-in-out"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Brand Logo Text with PemDes Logo -->
    <a href="/" class="flex items-center gap-2.5 group z-40">
      <img
        src="/logos/PemDes.png"
        alt="Logo Pemerintah Desa Ngampel Wetan"
        class="h-8 w-8 sm:h-9 sm:w-9 object-contain aspect-square transition-transform group-hover:scale-105"
        title="Pemerintah Desa Ngampel Wetan"
      />
      <span
        id="navBrandText"
        class="font-serif font-bold text-lg sm:text-xl text-heritage-warm-cream group-hover:text-white transition-colors duration-300"
      >
        Sendang Ngampel Wetan
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav id="navLinks" class="hidden md:flex items-center gap-6 text-sm font-medium text-heritage-warm-cream/90">
      <a href="/#tentang" class="hover:text-heritage-gold-accent transition-colors">Tentang</a>
      <a href="/#sejarah" class="hover:text-heritage-gold-accent transition-colors">Sejarah</a>
      <a href="/legenda" class="font-semibold hover:text-heritage-gold-accent transition-colors">Legenda</a>
      <a href="/#revitalisasi" class="hover:text-heritage-gold-accent transition-colors">Revitalisasi</a>
      <a href="/#galeri" class="hover:text-heritage-gold-accent transition-colors">Galeri</a>
      <a href="/#lokasi" class="hover:text-heritage-gold-accent transition-colors">Lokasi</a>
    </nav>

    <!-- Mobile Menu Toggle Button (Hamburger Icon Only) -->
    <button
      id="mobileMenuToggle"
      aria-label="Open Navigation Sidebar"
      class="md:hidden p-2 rounded-lg text-heritage-warm-cream focus:outline-none transition-colors z-40"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
</header>

<!-- Mobile Dark Backdrop Overlay -->
<div
  id="mobileBackdrop"
  class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"
></div>

<!-- Mobile Right Sidebar Drawer Panel -->
<aside
  id="mobileMenu"
  class="fixed top-0 right-0 bottom-0 w-72 max-w-[85vw] h-full bg-heritage-dark-brown text-heritage-warm-cream border-l border-heritage-gold-accent/30 shadow-2xl z-50 translate-x-full transition-transform duration-300 ease-in-out flex flex-col p-6 md:hidden"
>
  <!-- Sidebar Header -->
  <div class="flex items-center justify-between pb-6 border-b border-heritage-warm-brown/40 mb-6">
    <div class="flex items-center gap-2">
      <img src="/logos/PemDes.png" alt="Logo" class="h-7 w-7 object-contain" />
      <span class="font-serif font-bold text-sm text-heritage-warm-cream">Navigasi Heritage</span>
    </div>

    <!-- Close Button -->
    <button
      id="mobileMenuClose"
      aria-label="Close Navigation Sidebar"
      class="p-1.5 rounded-full bg-heritage-deep-brown text-heritage-cream hover:text-white transition-colors"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Sidebar Links List -->
  <nav class="flex flex-col space-y-4 text-left font-serif text-base">
    <a href="/#tentang" class="mobile-nav-link flex items-center gap-3 py-2 px-3 rounded-lg hover:bg-heritage-warm-brown/40 text-heritage-cream hover:text-heritage-gold-accent transition-colors">
      <span class="text-heritage-gold-accent text-xs">✦</span>
      <span>Tentang Sendang</span>
    </a>
    <a href="/#sejarah" class="mobile-nav-link flex items-center gap-3 py-2 px-3 rounded-lg hover:bg-heritage-warm-brown/40 text-heritage-cream hover:text-heritage-gold-accent transition-colors">
      <span class="text-heritage-gold-accent text-xs">✦</span>
      <span>Sejarah Ringkas</span>
    </a>
    <a href="/legenda" class="mobile-nav-link flex items-center gap-3 py-2 px-3 rounded-lg bg-heritage-warm-brown/30 text-heritage-gold-accent font-semibold border border-heritage-gold-accent/30">
      <span class="text-heritage-gold-accent text-xs">📜</span>
      <span>Manuskrip Legenda</span>
    </a>
    <a href="/#revitalisasi" class="mobile-nav-link flex items-center gap-3 py-2 px-3 rounded-lg hover:bg-heritage-warm-brown/40 text-heritage-cream hover:text-heritage-gold-accent transition-colors">
      <span class="text-heritage-gold-accent text-xs">✦</span>
      <span>Dokumentasi 2026</span>
    </a>
    <a href="/#galeri" class="mobile-nav-link flex items-center gap-3 py-2 px-3 rounded-lg hover:bg-heritage-warm-brown/40 text-heritage-cream hover:text-heritage-gold-accent transition-colors">
      <span class="text-heritage-gold-accent text-xs">✦</span>
      <span>Galeri Visual</span>
    </a>
    <a href="/#lokasi" class="mobile-nav-link flex items-center gap-3 py-2 px-3 rounded-lg hover:bg-heritage-warm-brown/40 text-heritage-cream hover:text-heritage-gold-accent transition-colors">
      <span class="text-heritage-gold-accent text-xs">📍</span>
      <span>Peta Lokasi</span>
    </a>
  </nav>

  <!-- Sidebar Footer Note -->
  <div class="mt-auto pt-6 border-t border-heritage-warm-brown/40 text-xs text-heritage-light-brown italic">
    <p>Sendang Ngampel Wetan</p>
    <p class="text-[11px] opacity-75">Rekarsa UIN Walisongo 2026</p>
  </div>
</aside>

<script>
  let lastScrollY = window.scrollY;
  const navbar = document.getElementById('navbar');
  const navBrandText = document.getElementById('navBrandText');
  const navLinks = document.getElementById('navLinks');
  const mobileMenuToggle = document.getElementById('mobileMenuToggle');
  const mobileMenuClose = document.getElementById('mobileMenuClose');
  const mobileBackdrop = document.getElementById('mobileBackdrop');
  const mobileMenu = document.getElementById('mobileMenu');
  let isMobileMenuOpen = false;

  function toggleMobileSidebar(open?: boolean) {
    isMobileMenuOpen = typeof open === 'boolean' ? open : !isMobileMenuOpen;
    if (mobileMenu && mobileBackdrop) {
      if (isMobileMenuOpen) {
        mobileMenu.classList.remove('translate-x-full');
        mobileMenu.classList.add('translate-x-0');
        mobileBackdrop.classList.remove('opacity-0', 'pointer-events-none');
        mobileBackdrop.classList.add('opacity-100', 'pointer-events-auto');
        document.body.style.overflow = 'hidden';
      } else {
        mobileMenu.classList.add('translate-x-full');
        mobileMenu.classList.remove('translate-x-0');
        mobileBackdrop.classList.add('opacity-0', 'pointer-events-none');
        mobileBackdrop.classList.remove('opacity-100', 'pointer-events-auto');
        document.body.style.overflow = '';
      }
    }
  }

  if (mobileMenuToggle) {
    mobileMenuToggle.addEventListener('click', () => toggleMobileSidebar(true));
  }

  if (mobileMenuClose) {
    mobileMenuClose.addEventListener('click', () => toggleMobileSidebar(false));
  }

  if (mobileBackdrop) {
    mobileBackdrop.addEventListener('click', () => toggleMobileSidebar(false));
  }

  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => toggleMobileSidebar(false));
  });

  function handleNavbarScroll() {
    if (!navbar) return;
    const currentScrollY = window.scrollY;
    const isHeroPage = !!document.getElementById('hero');
    const heroThreshold = isHeroPage ? window.innerHeight * 0.75 : 50;

    // 1. Hide on scroll down, show on scroll up (Slide animation)
    if (!isMobileMenuOpen) {
      if (currentScrollY > 80 && currentScrollY > lastScrollY + 4) {
        navbar.style.transform = 'translateY(-100%)';
      } else if (currentScrollY < lastScrollY - 4 || currentScrollY <= 80) {
        navbar.style.transform = 'translateY(0%)';
      }
    }

    // 2. Glassmorphism Backdrop Blur Background on Scroll
    if (currentScrollY > 50) {
      navbar.classList.add('bg-heritage-paper/90', 'backdrop-blur-md', 'border-b', 'border-heritage-light-brown/20', 'shadow-sm');
      navbar.classList.remove('bg-transparent');
    } else {
      navbar.classList.remove('bg-heritage-paper/90', 'backdrop-blur-md', 'border-b', 'border-heritage-light-brown/20', 'shadow-sm');
      navbar.classList.add('bg-transparent');
    }

    // 3. Dynamic Text & Button Colors
    if (isHeroPage && currentScrollY <= heroThreshold) {
      if (navBrandText) {
        navBrandText.classList.remove('text-heritage-dark-brown', 'group-hover:text-heritage-warm-brown');
        navBrandText.classList.add('text-heritage-warm-cream', 'group-hover:text-white');
      }

      if (navLinks) {
        navLinks.classList.remove('text-heritage-deep-brown');
        navLinks.classList.add('text-heritage-warm-cream/90');
      }

      if (mobileMenuToggle) {
        mobileMenuToggle.classList.remove('text-heritage-dark-brown');
        mobileMenuToggle.classList.add('text-heritage-warm-cream');
      }
    } else {
      if (navBrandText) {
        navBrandText.classList.remove('text-heritage-warm-cream', 'group-hover:text-white');
        navBrandText.classList.add('text-heritage-dark-brown', 'group-hover:text-heritage-warm-brown');
      }

      if (navLinks) {
        navLinks.classList.remove('text-heritage-warm-cream/90');
        navLinks.classList.add('text-heritage-deep-brown');
      }

      if (mobileMenuToggle) {
        mobileMenuToggle.classList.remove('text-heritage-warm-cream');
        mobileMenuToggle.classList.add('text-heritage-dark-brown');
      }
    }

    lastScrollY = currentScrollY;
  }

  window.addEventListener('scroll', handleNavbarScroll, { passive: true });
  handleNavbarScroll();
</script>
