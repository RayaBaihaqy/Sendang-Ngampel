---

<section id="lokasi" class="py-20 bg-heritage-warm-cream/40 border-t border-heritage-light-brown/20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-12">
      <span class="text-xs font-semibold uppercase tracking-widest text-heritage-light-brown">Petunjuk Arah &amp; Navigasi</span>
      <h2 class="text-3xl sm:text-4xl font-serif font-bold text-heritage-dark-brown mt-2">
        Lokasi Sendang Ngampel Wetan
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      <!-- Address Details Card -->
      <div class="lg:col-span-4 paper-card p-6 sm:p-8 flex flex-col justify-between">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-heritage-warm-brown/20 text-heritage-warm-brown text-xs font-medium mb-4">
            <span>📍 Peta Wilayah &amp; Plus Code</span>
          </div>

          <h3 class="text-2xl font-serif font-bold text-heritage-dark-brown mb-4">
            Sendang Ngampel Wetan
          </h3>

          <div class="space-y-3 text-sm text-heritage-deep-brown leading-relaxed">
            <div class="flex items-start gap-3">
              <span class="text-heritage-gold-accent font-bold mt-0.5">•</span>
              <p><strong>Plus Code GMaps:</strong> <code class="px-1.5 py-0.5 bg-heritage-paper rounded border border-heritage-light-brown/30 font-mono text-xs text-heritage-dark-brown">25GV+76R</code></p>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-heritage-gold-accent font-bold mt-0.5">•</span>
              <p><strong>Dusun/Krajan:</strong> Krajan 1 (Krajan Satu)</p>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-heritage-gold-accent font-bold mt-0.5">•</span>
              <p><strong>RT / RW:</strong> RT 01 / RW 01</p>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-heritage-gold-accent font-bold mt-0.5">•</span>
              <p><strong>Desa:</strong> Ngampel Wetan</p>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-heritage-gold-accent font-bold mt-0.5">•</span>
              <p><strong>Kecamatan:</strong> Ngampel</p>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-heritage-gold-accent font-bold mt-0.5">•</span>
              <p><strong>Kabupaten:</strong> Kendal, 51357</p>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-heritage-gold-accent font-bold mt-0.5">•</span>
              <p><strong>Provinsi:</strong> Jawa Tengah, Indonesia</p>
            </div>
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-heritage-light-brown/20">
          <a
            href="https://www.google.com/maps/search/?api=1&query=25GV%2B76R%2C+Krajan+Satu%2C+Ngampel+Wetan%2C+Kec.+Ngampel%2C+Kabupaten+Kendal%2C+Jawa+Tengah+51357"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full bg-heritage-warm-brown text-heritage-paper hover:bg-heritage-dark-brown transition-colors text-sm font-medium shadow-md group"
          >
            <span>Buka di Aplikasi Google Maps</span>
            <span class="text-xs group-hover:translate-x-0.5 transition-transform">↗</span>
          </a>
        </div>
      </div>

      <!-- Embedded Google Maps Frame -->
      <div class="lg:col-span-8 rounded-2xl overflow-hidden border border-heritage-light-brown/40 shadow-xl min-h-[350px] relative bg-heritage-paper">
        <iframe
          title="Peta Lokasi Sendang Ngampel Wetan (25GV+76R)"
          src="https://maps.google.com/maps?q=25GV%2B76R%2C+Krajan+Satu%2C+Ngampel+Wetan%2C+Kec.+Ngampel%2C+Kabupaten+Kendal%2C+Jawa+Tengah+51357&t=&z=17&ie=UTF8&iwloc=&output=embed"
          width="100%"
          height="100%"
          style="border:0; min-height: 420px;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="w-full h-full"
        ></iframe>
      </div>
    </div>
  </div>
</section>
