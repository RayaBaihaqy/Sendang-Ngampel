---
---

<section id="revitalisasi" class="py-20 bg-heritage-warm-cream/30 border-y border-heritage-light-brown/20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-14">
      <span class="text-xs font-semibold uppercase tracking-widest text-heritage-accent-green">Dokumentasi 2026</span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif font-bold text-heritage-dark-brown mt-2">
        Revitalisasi Sendang
      </h2>
      <p class="mt-4 text-base text-heritage-deep-brown/80 max-w-2xl mx-auto">
        Upaya perawatan dan penataan lingkungan Sendang agar kondisinya lebih bersih, tertata rapi, dan nyaman untuk kegiatan tradisi warga seperti Nyadran.
      </p>
    </div>

    <!-- 2 Column Before / After & Program Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Card Before -->
      <div class="paper-card p-6 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-semibold px-3 py-1 rounded-full bg-heritage-warm-brown/20 text-heritage-warm-brown">Tahap Awal</span>
            <span class="text-xs text-heritage-light-brown">Dokumentasi Kondisi</span>
          </div>
          <h3 class="text-xl font-serif font-bold text-heritage-dark-brown mb-2">Kondisi Sebelum Revitalisasi</h3>
          <p class="text-sm text-heritage-deep-brown/90 mb-4 leading-relaxed">
            Sebelum proses pembenahan pada tahun 2026, area sekitar mata air Sendang memerlukan pembersihan berkala dan penataan saluran aliran air agar terhindar dari pendangkalan.
          </p>
        </div>
        <!-- Photocard Frame Before -->
        <div class="p-2.5 pb-5 bg-heritage-warm-cream border border-heritage-light-brown/30 rounded-2xl shadow-md mt-4">
          <div class="rounded-xl overflow-hidden border border-heritage-light-brown/20 bg-heritage-paper">
            <img
              src="/images/sendang/sendang sblm1.png"
              alt="Kondisi Sebelum Revitalisasi Sendang Ngampel Wetan"
              class="w-full h-56 object-cover hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>
          <p class="text-center text-xs font-serif italic text-heritage-light-brown mt-2">Dokumentasi Awal</p>
        </div>
      </div>

      <!-- Card After -->
      <div class="paper-card p-6 flex flex-col justify-between border-heritage-accent-green/30">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-semibold px-3 py-1 rounded-full bg-heritage-accent-green/20 text-heritage-accent-green">Hasil Revitalisasi</span>
            <span class="text-xs text-heritage-accent-green font-medium">Tahun 2026</span>
          </div>
          <h3 class="text-xl font-serif font-bold text-heritage-dark-brown mb-2">Kondisi Sesudah Revitalisasi</h3>
          <p class="text-sm text-heritage-deep-brown/90 mb-4 leading-relaxed">
            Lingkungan Sendang kini lebih higienis, indah, serta dilengkapi papan informasi fisik berbasis QR Code untuk memudahkan warga dan pengunjung mempelajari legenda lokal.
          </p>
        </div>
        <!-- Photocard Frame After -->
        <div class="p-2.5 pb-5 bg-heritage-warm-cream border border-heritage-accent-green/30 rounded-2xl shadow-md mt-4">
          <div class="rounded-xl overflow-hidden border border-heritage-accent-green/20 bg-heritage-paper">
            <img
              src="/images/sendang/sendang.jpeg"
              alt="Kondisi Sesudah Revitalisasi Sendang Ngampel Wetan"
              class="w-full h-56 object-cover hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>
          <p class="text-center text-xs font-serif italic text-heritage-accent-green mt-2">Dokumentasi 2026</p>
        </div>
      </div>
    </div>
  </div>
</section>
